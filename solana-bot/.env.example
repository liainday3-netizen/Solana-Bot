# ============================================================
#  SOLANA TRADING BOT — ENVIRONMENT CONFIGURATION
# ============================================================
#
#  Copy this file to .env and fill in your values.
#  NEVER share your .env file. NEVER commit it to git.
#
#  !!!!!!!!!!!!!!!!!!! PRIVATE KEY WARNING !!!!!!!!!!!!!!!!!!!
#
#  Your PRIVATE_KEY gives COMPLETE CONTROL over your wallet.
#  Anyone who sees it can drain all your funds instantly.
#  There is no way to undo or recover stolen crypto.
#
#  Rules for your private key:
#  1. NEVER share it — not with friends, not with "support"
#  2. NEVER post it online or in any chat / email / ticket
#  3. NEVER commit it to git (add .env to .gitignore)
#  4. NEVER type it anywhere except this .env file
#  5. Use a DEDICATED wallet with ONLY the money you can lose
#  6. Consider using a hardware wallet for real funds
#
#  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

# ── Mode ──────────────────────────────────────────────────────
# Set to "true" for paper trading (SAFE, default)
# Set to "false" ONLY if you fully understand all risks
PAPER_MODE=true

# ── Wallet keys (only needed for live mode) ───────────────────
#
# Your Phantom wallet PRIVATE KEY (base-58 string).
# Export from: Phantom → Settings → Security & Privacy → Export Private Key
#
# ⚠️  NEVER share this value with anyone.
# ⚠️  Keep this file out of version control (.gitignore).
#
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE_NEVER_SHARE_THIS

# Your wallet's PUBLIC KEY (safe to share, your wallet address)
WALLET_PUBLIC_KEY=YOUR_WALLET_PUBLIC_ADDRESS_HERE

# ── Optional Solana RPC endpoint ──────────────────────────────
# Default uses public mainnet-beta. For better reliability, use
# a private RPC like Helius, Alchemy, or QuickNode.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
