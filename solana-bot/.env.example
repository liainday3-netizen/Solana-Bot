# ============================================================
#  SOLANA TRADING BOT — ENVIRONMENT CONFIGURATION
# ============================================================
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER share your .env file. NEVER commit it to git.
#  It contains your PRIVATE KEY — the keys to your wallet.
#
#  !!!!!!!!!!!!!!!!!!! PRIVATE KEY WARNING !!!!!!!!!!!!!!!!!!!
#
#  Your PRIVATE_KEY gives COMPLETE CONTROL over your wallet.
#  Anyone who sees it can drain all your funds — instantly.
#  There is no recovery. There is no undo.
#
#  Rules:
#  1. NEVER share it with anyone — including "support"
#  2. NEVER paste it in chat, email, Discord, or tickets
#  3. NEVER commit it to git (it's already in .gitignore)
#  4. Only enter it in this .env file, nowhere else
#  5. Use a DEDICATED wallet with only money you can lose
#  6. Consider a hardware wallet for significant amounts
#
#  How to export from Phantom:
#    Phantom → Settings → Security & Privacy → Export Private Key
#    It will be a long base-58 string starting with a number.
#
#  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

# ── Mode ──────────────────────────────────────────────────────
# "true"  = paper trading, virtual money, completely safe
# "false" = live trading, real money, irreversible transactions
#
# This is only the default for the interactive prompt.
# --paper and --live flags always override this.
PAPER_MODE=true

# ── Wallet — required for live mode ──────────────────────────
#
# Your Phantom public key (wallet address). Safe to share.
WALLET_PUBLIC_KEY=YOUR_WALLET_ADDRESS_HERE

# Your Phantom PRIVATE KEY (base-58). NEVER share this.
# Export: Phantom → Settings → Security & Privacy → Export Private Key
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE_NEVER_SHARE_THIS

# ── Solana RPC endpoint ───────────────────────────────────────
# The default public endpoint works but can be slow/rate-limited.
# For reliable live trading, use a private RPC:
#   Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   QuickNode: https://your-endpoint.quiknode.pro/YOUR_KEY/
#   Alchemy:   https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
